@page "/reportes/existencias"
@using PuntoVentaWeb.Models
@using PuntoVentaWeb.Services
@inject ApiClient Api
@inject SesionService Sesion
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Reporte de existencias</PageTitle>

@if (!sesionLista)
{
    <p class="text-muted">Cargando…</p>
}
else if (!Sesion.Iniciada)
{
    <p class="text-muted">Redirigiendo al inicio de sesión…</p>
}
else
{
    <div class="d-flex justify-content-between align-items-start mb-3 pv-no-imprimir">
        <div>
            <a href="/reportes" class="text-decoration-none text-muted small"><i class="bi bi-arrow-left"></i> Reportes</a>
            <h3 class="mb-0"><i class="bi bi-boxes text-primary"></i> Reporte de existencias</h3>
            <small class="text-muted">Ordenado de menor a mayor existencia, para ver primero lo que hay que reabastecer</small>
        </div>
        <button class="btn btn-outline-secondary" @onclick="Imprimir">
            <i class="bi bi-printer"></i> Imprimir
        </button>
    </div>

    @if (!string.IsNullOrEmpty(mensajeError))
    {
        <div class="alert alert-danger alert-dismissible pv-no-imprimir">
            @mensajeError
            <button type="button" class="btn-close" @onclick="() => mensajeError = string.Empty"></button>
        </div>
    }

    <div class="pv-encabezado-impresion mb-3 d-none d-print-block">
        <h4 class="mb-0">Reporte de existencias</h4>
        <small class="text-muted">Generado el @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</small>
    </div>

    @if (!cargando)
    {
        <div class="row g-3 mb-3 pv-no-imprimir">
            <div class="col-md-4">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <small class="text-muted text-uppercase">Productos agotados</small>
                        <div class="fs-3 fw-bold text-danger">@productos.Count(p => p.Existencia <= 0)</div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <small class="text-muted text-uppercase">Existencia baja (≤ @UmbralBajo)</small>
                        <div class="fs-3 fw-bold text-warning">@productos.Count(p => p.Existencia > 0 && p.Existencia <= UmbralBajo)</div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <small class="text-muted text-uppercase">Valor total en inventario (costo)</small>
                        <div class="fs-3 fw-bold text-success">Q @productos.Sum(p => p.Existencia * p.PrecioCosto).ToString("0.00")</div>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Producto</th>
                        <th>Marca</th>
                        <th class="text-center">Existencia</th>
                        <th class="text-center">Estado</th>
                        <th class="text-end">Valor en inventario</th>
                    </tr>
                </thead>
                <tbody>
                    @if (cargando)
                    {
                        <tr><td colspan="5" class="text-center text-muted py-4">Cargando…</td></tr>
                    }
                    else if (productos.Count == 0)
                    {
                        <tr><td colspan="5" class="text-center text-muted py-4">No hay productos registrados.</td></tr>
                    }
                    else
                    {
                        @foreach (var p in productos)
                        {
                            <tr>
                                <td>@p.Producto</td>
                                <td>@p.Marca</td>
                                <td class="text-center">@p.Existencia</td>
                                <td class="text-center">
                                    @if (p.Existencia <= 0)
                                    {
                                        <span class="badge text-bg-danger">Agotado</span>
                                    }
                                    else if (p.Existencia <= UmbralBajo)
                                    {
                                        <span class="badge text-bg-warning text-dark">Existencia baja</span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-success">Normal</span>
                                    }
                                </td>
                                <td class="text-end">Q @((p.Existencia * p.PrecioCosto).ToString("0.00"))</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<style>
    @@media print {
        .pv-no-imprimir { display: none !important; }
    }
</style>

@code {
    private const int UmbralBajo = 5;

    private List<ProductoDto> productos = new();
    private bool cargando = true;
    private bool sesionLista;
    private string mensajeError = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await Sesion.RestaurarAsync();
        sesionLista = true;

        if (!Sesion.Iniciada)
        {
            Nav.NavigateTo("/login");
            return;
        }

        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        cargando = true;
        StateHasChanged();

        var resultado = await Api.ObtenerAsync<List<ProductoDto>>("api/productos");
        if (resultado.Ok)
        {
            productos = (resultado.Datos ?? new()).OrderBy(p => p.Existencia).ToList();
        }
        else
        {
            mensajeError = resultado.Mensaje;
            if (!Sesion.Iniciada) Nav.NavigateTo("/login");
        }

        cargando = false;
    }

    private async Task Imprimir()
    {
        await JS.InvokeVoidAsync("print");
    }
}
