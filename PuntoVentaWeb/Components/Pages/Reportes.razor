@page "/reportes"
@using PuntoVentaWeb.Services
@inject SesionService Sesion
@inject NavigationManager Nav

<PageTitle>Reportes</PageTitle>

@if (!sesionLista)
{
    <p class="text-muted">Cargando…</p>
}
else if (!Sesion.Iniciada)
{
    <p class="text-muted">Redirigiendo al inicio de sesión…</p>
}
else
{
    <div class="mb-4">
        <h3 class="mb-0"><i class="bi bi-bar-chart-line text-primary"></i> Reportes</h3>
        <small class="text-muted">Información consolidada del sistema</small>
    </div>

    <div class="row g-3">
        @if (Sesion.PuedeAdministrar)
        {
            <div class="col-md-6 col-xl-3">
                <a href="/reportes/productos" class="text-decoration-none">
                <div class="card shadow-sm h-100 pv-tarjeta-reporte">
                    <div class="card-body text-center py-4">
                        <i class="bi bi-box-seam fs-1 text-primary"></i>
                        <h5 class="mt-3 mb-1">Productos</h5>
                        <p class="text-muted small mb-0">Catálogo con marca, existencia y precios</p>
                    </div>
                </div>
                </a>
            </div>
        }
        @if (Sesion.PuedeAdministrar || Sesion.EsBodeguero)
        {
            <div class="col-md-6 col-xl-3">
                <a href="/reportes/existencias" class="text-decoration-none">
                <div class="card shadow-sm h-100 pv-tarjeta-reporte">
                    <div class="card-body text-center py-4">
                        <i class="bi bi-boxes fs-1 text-primary"></i>
                        <h5 class="mt-3 mb-1">Existencias</h5>
                        <p class="text-muted small mb-0">Inventario y estado de stock por producto</p>
                    </div>
                </div>
                </a>
            </div>
        }
        @if (Sesion.PuedeAdministrar || Sesion.EsBodeguero)
        {
            <div class="col-md-6 col-xl-3">
                <a href="/reportes/compras" class="text-decoration-none">
                <div class="card shadow-sm h-100 pv-tarjeta-reporte">
                    <div class="card-body text-center py-4">
                        <i class="bi bi-truck fs-1 text-primary"></i>
                        <h5 class="mt-3 mb-1">Compras</h5>
                        <p class="text-muted small mb-0">Órdenes de compra por proveedor y fecha</p>
                    </div>
                </div>
                </a>
            </div>
        }
        @if (Sesion.PuedeAdministrar || Sesion.EsCajero)
        {
            <div class="col-md-6 col-xl-3">
                <a href="/reportes/ventas" class="text-decoration-none">
                <div class="card shadow-sm h-100 pv-tarjeta-reporte">
                    <div class="card-body text-center py-4">
                        <i class="bi bi-cash-coin fs-1 text-primary"></i>
                        <h5 class="mt-3 mb-1">Ventas</h5>
                        <p class="text-muted small mb-0">Facturas por cliente, empleado y fecha</p>
                    </div>
                </div>
                </a>
            </div>
        }
    </div>
}

<style>
    .pv-tarjeta-reporte {
        transition: transform .1s ease, box-shadow .1s ease;
        color: inherit;
    }

    .pv-tarjeta-reporte:hover {
        transform: translateY(-3px);
        box-shadow: 0 .5rem 1rem rgba(0,0,0,.1) !important;
    }
</style>

@code {
    private bool sesionLista;

    protected override async Task OnInitializedAsync()
    {
        await Sesion.RestaurarAsync();
        sesionLista = true;

        if (!Sesion.Iniciada)
        {
            Nav.NavigateTo("/login");
        }
    }
}
