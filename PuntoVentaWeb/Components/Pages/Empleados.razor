@page "/empleados"
@using PuntoVentaWeb.Models
@using PuntoVentaWeb.Services
@inject ApiClient Api
@inject SesionService Sesion
@inject NavigationManager Nav

<PageTitle>Empleados</PageTitle>

@if (!sesionLista)
{
    <p class="text-muted">Cargando…</p>
}
else if (!Sesion.Iniciada)
{
    <p class="text-muted">Redirigiendo al inicio de sesión…</p>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h3 class="mb-0"><i class="bi bi-person-badge text-primary"></i> Empleados</h3>
            <small class="text-muted">Personal registrado para operar la tienda</small>
        </div>
        <button class="btn btn-primary" @onclick="AbrirNuevo" disabled="@(puestos.Count == 0)">
            <i class="bi bi-plus-lg"></i> Nuevo empleado
        </button>
    </div>

    @if (puestos.Count == 0 && !cargando)
    {
        <div class="alert alert-warning">
            Primero registre al menos un <a href="/puestos">puesto</a> para poder agregar empleados.
        </div>
    }

    @if (!string.IsNullOrEmpty(mensajeError))
    {
        <div class="alert alert-danger alert-dismissible">
            @mensajeError
            <button type="button" class="btn-close" @onclick="() => mensajeError = string.Empty"></button>
        </div>
    }
    @if (!string.IsNullOrEmpty(mensajeExito))
    {
        <div class="alert alert-success alert-dismissible">
            @mensajeExito
            <button type="button" class="btn-close" @onclick="() => mensajeExito = string.Empty"></button>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-header bg-white">
            <div class="input-group">
                <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                <input class="form-control" placeholder="Buscar por nombre, apellido o DPI…" @bind-value="textoBusqueda" @bind-value:event="oninput" @onkeyup="BuscarConRetraso" />
            </div>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Empleado</th>
                        <th>DPI</th>
                        <th>Puesto</th>
                        <th>Género</th>
                        <th>Teléfono</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (cargando)
                    {
                        <tr><td colspan="6" class="text-center text-muted py-4">Cargando…</td></tr>
                    }
                    else if (empleados.Count == 0)
                    {
                        <tr><td colspan="6" class="text-center text-muted py-4">No hay empleados registrados.</td></tr>
                    }
                    else
                    {
                        @foreach (var e in empleados)
                        {
                            <tr>
                                <td class="fw-semibold">@e.Nombres @e.Apellidos</td>
                                <td>@e.Dpi</td>
                                <td><span class="badge text-bg-light border">@e.Puesto</span></td>
                                <td>@(e.Genero ? "Masculino" : "Femenino")</td>
                                <td>@(e.Telefono ?? "—")</td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-outline-secondary me-1" title="Editar" @onclick="() => AbrirEditar(e)">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger" title="Eliminar" @onclick="() => ConfirmarEliminar(e)">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@if (mostrarModal && actual is not null)
{
    <div class="modal d-block" tabindex="-1" style="background-color: rgba(0,0,0,.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <EditForm Model="actual" OnValidSubmit="Guardar">
                    <DataAnnotationsValidator />
                    <div class="modal-header">
                        <h5 class="modal-title">@(esEdicion ? "Editar empleado" : "Nuevo empleado")</h5>
                        <button type="button" class="btn-close" @onclick="CerrarModal"></button>
                    </div>
                    <div class="modal-body">
                        @if (!string.IsNullOrWhiteSpace(errorModal))
                        {
                            <div class="alert alert-danger">@errorModal</div>
                        }
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Nombres</label>
                                <InputText class="form-control" @bind-Value="actual.Nombres" />
                                <ValidationMessage For="() => actual.Nombres" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Apellidos</label>
                                <InputText class="form-control" @bind-Value="actual.Apellidos" />
                                <ValidationMessage For="() => actual.Apellidos" />
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">DPI</label>
                                <InputText class="form-control" @bind-Value="actual.Dpi" placeholder="13 dígitos" />
                                <ValidationMessage For="() => actual.Dpi" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Teléfono</label>
                                <InputText class="form-control" @bind-Value="actual.Telefono" placeholder="55551234" />
                                <ValidationMessage For="() => actual.Telefono" />
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Dirección</label>
                            <InputText class="form-control" @bind-Value="actual.Direccion" />
                            <ValidationMessage For="() => actual.Direccion" />
                        </div>
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Puesto</label>
                                <InputSelect class="form-select" @bind-Value="actual.IdPuesto">
                                    <option value="0">Seleccione…</option>
                                    @foreach (var p in puestos)
                                    {
                                        <option value="@p.IdPuesto">@p.Puesto</option>
                                    }
                                </InputSelect>
                                <ValidationMessage For="() => actual.IdPuesto" />
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Género</label>
                                <div class="pt-2">
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input" type="radio" checked="@actual.Genero" @onchange="@(() => actual.Genero = true)" />
                                        <label class="form-check-label">Masculino</label>
                                    </div>
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input" type="radio" checked="@(!actual.Genero)" @onchange="@(() => actual.Genero = false)" />
                                        <label class="form-check-label">Femenino</label>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Fecha de nacimiento</label>
                                <InputDate class="form-control" min="@FechaNacimientoMinima" max="@FechaNacimientoMaxima" @bind-Value="actual.FechaNacimiento" />
                                <ValidationMessage For="() => actual.FechaNacimiento" />
                                <small class="text-muted">El empleado debe tener entre @EdadMinimaLaboral y @EdadMaximaRazonable años.</small>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Fecha de inicio de labores</label>
                            <InputDate class="form-control" @bind-Value="actual.FechaInicioLabores" />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" @onclick="CerrarModal">Cancelar</button>
                        <button type="submit" class="btn btn-primary" disabled="@guardando">
                            @(guardando ? "Guardando…" : "Guardar")
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@if (empleadoAEliminar is not null)
{
    <div class="modal d-block" tabindex="-1" style="background-color: rgba(0,0,0,.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Eliminar empleado</h5>
                    <button type="button" class="btn-close" @onclick="() => empleadoAEliminar = null"></button>
                </div>
                <div class="modal-body">
                    <p>¿Eliminar a <strong>@empleadoAEliminar.Nombres @empleadoAEliminar.Apellidos</strong>? Esta acción no se puede deshacer.</p>
                    @if (!string.IsNullOrWhiteSpace(errorModal))
                    {
                        <div class="alert alert-danger">@errorModal</div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-outline-secondary" @onclick="() => empleadoAEliminar = null">Cancelar</button>
                    <button class="btn btn-danger" @onclick="Eliminar" disabled="@guardando">Eliminar</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<EmpleadoDto> empleados = new();
    private List<PuestoDto> puestos = new();
    private EmpleadoDto? actual;
    private EmpleadoDto? empleadoAEliminar;
    private bool mostrarModal;
    private bool esEdicion;
    private bool cargando = true;
    private bool guardando;
    private bool sesionLista;
    private string textoBusqueda = string.Empty;
    private string mensajeError = string.Empty;
    private string mensajeExito = string.Empty;
    private string errorModal = string.Empty;
    private CancellationTokenSource? retraso;

    private const int EdadMinimaLaboral = 18;
    private const int EdadMaximaRazonable = 80;

    private string FechaNacimientoMaxima => DateTime.Today.AddYears(-EdadMinimaLaboral).ToString("yyyy-MM-dd");
    private string FechaNacimientoMinima => DateTime.Today.AddYears(-EdadMaximaRazonable).ToString("yyyy-MM-dd");

    protected override async Task OnInitializedAsync()
    {
        await Sesion.RestaurarAsync();
        sesionLista = true;

        if (!Sesion.Iniciada)
        {
            Nav.NavigateTo("/login");
            return;
        }

        var resultadoPuestos = await Api.ObtenerAsync<List<PuestoDto>>("api/puestos");
        if (resultadoPuestos.Ok)
        {
            puestos = resultadoPuestos.Datos ?? new();
        }

        await CargarAsync();
    }

    private async Task CargarAsync(string? buscar = null)
    {
        cargando = true;
        StateHasChanged();

        var url = string.IsNullOrWhiteSpace(buscar) ? "api/empleados" : $"api/empleados?buscar={Uri.EscapeDataString(buscar)}";
        var resultado = await Api.ObtenerAsync<List<EmpleadoDto>>(url);

        if (resultado.Ok)
        {
            empleados = resultado.Datos ?? new();
        }
        else
        {
            mensajeError = resultado.Mensaje;
            if (!Sesion.Iniciada) Nav.NavigateTo("/login");
        }

        cargando = false;
    }

    private async Task BuscarConRetraso()
    {
        retraso?.Cancel();
        retraso = new CancellationTokenSource();
        var token = retraso.Token;

        try
        {
            await Task.Delay(350, token);
            if (!token.IsCancellationRequested)
            {
                await CargarAsync(textoBusqueda);
            }
        }
        catch (TaskCanceledException) { }
    }

    private void AbrirNuevo()
    {
        actual = new EmpleadoDto();
        esEdicion = false;
        errorModal = string.Empty;
        mostrarModal = true;
    }

    private void AbrirEditar(EmpleadoDto e)
    {
        actual = e.Clonar();
        esEdicion = true;
        errorModal = string.Empty;
        mostrarModal = true;
    }

    private void CerrarModal()
    {
        mostrarModal = false;
        actual = null;
    }

    private async Task Guardar()
    {
        if (actual is null) return;

        errorModal = string.Empty;

        if (actual.FechaNacimiento is not DateTime fechaNacimiento)
        {
            errorModal = "La fecha de nacimiento es obligatoria.";
            return;
        }

        if (fechaNacimiento.Date > DateTime.Today)
        {
            errorModal = "La fecha de nacimiento no puede ser una fecha futura.";
            return;
        }

        var edad = DateTime.Today.Year - fechaNacimiento.Year;
        if (fechaNacimiento.Date > DateTime.Today.AddYears(-edad)) edad--;

        if (edad < EdadMinimaLaboral || edad > EdadMaximaRazonable)
        {
            errorModal = $"El empleado debe tener entre {EdadMinimaLaboral} y {EdadMaximaRazonable} años.";
            return;
        }

        guardando = true;

        var resultado = esEdicion
            ? await Api.EnviarAsync(HttpMethod.Put, $"api/empleados/{actual.IdEmpleado}", actual)
            : await Api.EnviarAsync(HttpMethod.Post, "api/empleados", actual);

        guardando = false;

        if (resultado.Ok)
        {
            mensajeExito = esEdicion ? "Empleado actualizado correctamente." : "Empleado registrado correctamente.";
            mostrarModal = false;
            actual = null;
            await CargarAsync(textoBusqueda);
        }
        else
        {
            errorModal = resultado.Mensaje;
        }
    }

    private void ConfirmarEliminar(EmpleadoDto e)
    {
        empleadoAEliminar = e;
        errorModal = string.Empty;
    }

    private async Task Eliminar()
    {
        if (empleadoAEliminar is null) return;

        guardando = true;
        var resultado = await Api.EnviarAsync(HttpMethod.Delete, $"api/empleados/{empleadoAEliminar.IdEmpleado}");
        guardando = false;

        if (resultado.Ok)
        {
            mensajeExito = "Empleado eliminado correctamente.";
            empleadoAEliminar = null;
            await CargarAsync(textoBusqueda);
        }
        else
        {
            errorModal = resultado.Mensaje;
        }
    }
}
